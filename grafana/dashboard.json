{
  "title": "Maintenance-Window-Aware Alerting",
  "uid": "mwaa-overview",
  "schemaVersion": 39,
  "timezone": "utc",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Alerts by rule (last 7 days)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "mwaa-postgres" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT rule_name AS metric, count(*) AS value FROM alerts WHERE ts > now() - interval '7 days' GROUP BY rule_name ORDER BY value DESC",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Alerts in window vs. out of window",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "mwaa-postgres" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT window_state AS metric, count(*) AS value FROM alerts WHERE ts > now() - interval '7 days' GROUP BY window_state",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "Alert feed",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "mwaa-postgres" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT ts, rule_name, host, attraction, window_state, explanation FROM alerts ORDER BY ts DESC LIMIT 200",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Published maintenance windows (next 14 days)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "postgres", "uid": "mwaa-postgres" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT \"start\", \"end\", attraction, host, window_type, ticket, description FROM calendar_windows WHERE \"start\" < now() + interval '14 days' ORDER BY \"start\"",
          "format": "table"
        }
      ]
    }
  ]
}
